#!/bin/sh
# Open your coding agent in a folder with a task as its first message.
#
#   bin/ask-agent <folder> <prompt>
#
# The agent is $AGENT, else Omarchy's default agent, else claude if it is on PATH, else codex
# if it is (the rule `solo gm` follows too). Claude Code and Codex take the prompt on the
# command line and stay open for the rest of the conversation; any other agent gets the
# prompt printed, to paste in.
set -eu

folder=$1
prompt=$2
agent=${AGENT:-}
other="choose another with: omarchy default agent <name>"
if [ -n "$agent" ]; then
  other="set AGENT to another, or unset it"
elif [ -r "$HOME/.config/omarchy/defaults/agent" ]; then
  # The first word of the file, as solo reads it: past blank lines, and without a Windows line end.
  agent=$(awk '{ gsub(/\r/, "") } NF { print $1; exit }' "$HOME/.config/omarchy/defaults/agent")
fi
if [ -z "$agent" ]; then
  for found in claude codex; do
    if command -v "$found" >/dev/null 2>&1; then
      agent=$found
      break
    fi
  done
fi

cd "$folder"
case "$agent" in
  claude|codex)
    if command -v "$agent" >/dev/null 2>&1; then
      exec "$agent" "$prompt"
    fi
    printf "\n%s isn't on PATH: install it, or %s.\nThen open your agent in %s and give it this:\n\n%s\n\n" "$agent" "$other" "$folder" "$prompt"
    exit 0
    ;;
  "")
    printf '\nNo coding agent was found: install Claude Code or Codex, or choose one with: omarchy default agent <name>.\nThen open it in %s and give it this:\n\n%s\n\n' "$folder" "$prompt"
    exit 0
    ;;
esac
printf '\n%s is not something this script can start with a prompt.\nOpen your agent in %s and give it this:\n\n%s\n\n' "$agent" "$folder" "$prompt"
